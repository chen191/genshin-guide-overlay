{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "原神攻略悬浮窗",
  "version": "0.1.10",
  "identifier": "com.renlong.genshinguideoverlay",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "shortcut-settings",
        "title": "快捷键设置",
        "url": "shortcuts.html",
        "width": 430,
        "height": 410,
        "resizable": false,
        "minimizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.hdslb.com https://*.biliimg.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
